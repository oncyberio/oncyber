rules_version = '2';
// Local emulator only (local-dev/firebase.json). The project id starts with
// "demo-", so the emulator never reaches a real Firebase project. Signed-in
// demo accounts may read and write anything; nothing here is deployed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
