{
    "name": "functions",
    "scripts": {
        "build": "tsc && tsc-alias",
        "build:watch": "tsc --watch & tsc-alias --watch",
        "serve": "concurrently --kill-others \"firebase emulators:start --only functions\" \"npm run build:watch\"",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@gltf-transform/core": "^3.5.1",
        "@gltf-transform/extensions": "^3.5.1",
        "@gltf-transform/functions": "^3.5.1",
        "@pinata/sdk": "^2.1.0",
        "basisu": "^1.16.3",
        "busboy": "^1.6.0",
        "cli-table3": "^0.6.3",
        "command-exists": "^1.2.9",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "csv-stringify": "^6.4.0",
        "dotenv": "^16.0.3",
        "draco3dgltf": "^1.5.6",
        "express": "^4.18.2",
        "firebase-admin": "^12.7.0",
        "firebase-functions": "^5.1.1",
        "jsonwebtoken": "^9.0.3",
        "meshoptimizer": "^0.19.0",
        "micromatch": "^4.0.5",
        "sharp": "^0.35.5",
        "snowflake-sdk": "^1.6.21"
    },
    "devDependencies": {
        "concurrently": "^8.2.0",
        "tsc-alias": "^1.8.7",
        "typescript": "~5.6.3"
    },
    "private": true,
    "volta": {
        "node": "22.23.4"
    },
    "overrides": {
        "axios": "^1.21.1",
        "sharp": "^0.35.5",
        "toml": "^5.0.1"
    }
}
