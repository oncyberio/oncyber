{
    "compilerOptions": {
        "module": "commonjs",
        "outDir": "lib",
        "sourceMap": true,
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowJs": true,
        "target": "es2017",
        "rootDir": "src",
        "baseUrl": "src",
        "typeRoots": ["./node_modules/@types"]
    },
    "compileOnSave": true,
    "include": ["src"]
}
