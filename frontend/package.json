        "check": "tsc --noEmit",
        "check:types": "node scripts/type-ratchet.mjs",
        "check:types:update": "node scripts/type-ratchet.mjs --update",
        "test:scripts": "node --test scripts/type-ratchet.test.mjs",
        "start": "next start",
        "analyze": "cross-env ANALYSE=true npm run build",
        "test": "jest",
        "test:lobby-swc": "node scripts/check-lobby-swc.cjs",
        "test:lobby-feel": "jest --runInBand features/lobby/testing/feelSimulation.test.ts features/lobby/LobbyInputPrediction.test.ts features/lobby/LobbyNetwork.test.ts features/lobby/testing/feelPage.test.tsx",
        "dev:https": "node scripts/fetch-licensed-fonts.mjs && next dev --port 13000 --experimental-https",
        "find:unused": "knip --include files,dependencies"
