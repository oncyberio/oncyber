# Copy to frontend/.env.local only if that file does not already exist.
# This is a core-settings template, not an isolated/offline configuration.
# Firebase settings are required: production builds fail without them.

# Next.js application origin, including its /api routes (not the Express API).
NEXT_PUBLIC_API=http://localhost:13000

# Optional local protocol-v1 crowd lobby.
# Start separately: npm --prefix multiplayer run lobby:dev
NEXT_PUBLIC_LOBBY_REGIONS='[{"id":"local","httpUrl":"http://127.0.0.1:2568","wsUrl":"ws://127.0.0.1:2568","protocol":1}]'
NEXT_PUBLIC_LOBBY_REGION=local

# Space rooms, voice signaling and TURN credentials (multiplayer/Dockerfile).
# Defaults to arena.oncyber.io. Local: npm --prefix multiplayer start
# NEXT_PUBLIC_ARENA_URL=http://localhost:2567

# Firebase browser configuration from your own development project.
# NEXT_PUBLIC_* values are visible to browser users.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional Cloud Functions base URL (emulator or another region).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=

# Server-only Firebase Admin settings used by account/database API routes.
# Supply your development service-account values; never prefix these NEXT_PUBLIC_.
# Some local rendering fixtures can run without them; database routes cannot.
FIREBASE_ADMIN_TYPE=service_account
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_CLIENT_ID=
FIREBASE_ADMIN_AUTH_URI=
FIREBASE_ADMIN_TOKEN_URI=
FIREBASE_ADMIN_AUTH_PROVIDER_x509_CERT_URL=
FIREBASE_ADMIN_CLIENT_x509_CERT_URL=
# Optional Realtime Database URL override. Blank uses <project>-default-rtdb.
FIREBASE_ADMIN_DATABASE_URL=

# Server-side token operations; generate your own local secret before using them.
SECRET_JWT_KEY=

# Third-party API keys. Leave blank to disable the features that need them.
# NEXT_PUBLIC_* values are visible to browser users; restrict them by domain.
NEXT_PUBLIC_ETH_MAINNET_RPC=
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_BASE_RPC=
# Shape mainnet (chain ID 360), for NFT gating. Defaults to the public RPC.
NEXT_PUBLIC_SHAPE_RPC=
# Solana RPC with the Metaplex DAS API, for Solana NFT listings.
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_RESERVOIR_API_KEY=
NEXT_PUBLIC_SOUNDXYZ_API_KEY=
NEXT_PUBLIC_BICONOMY_API_KEY=
# Server-only.
OPENSEA_X_API_KEY=
NFTPORT_API_KEY=
PINATA_API_KEY=
PINATA_API_SECRET=
# Uploads. The browser never gets this key: the server signs a short-lived
# upload URL with it, so the key needs write access to files.
PINATA_JWT_KEY=
# Game releases (docs/games/releases.md). Default: a local folder, no keys.
# GAMES_RELEASES_BACKEND=pinata needs PINATA_JWT_KEY and a gateway origin.
# The publishing scripts read these three from the shell, not from this
# file; the site reads only GAMES_RELEASES_DIR, and finds a pinned
# release's gateway in the committed pointer file.
GAMES_RELEASES_BACKEND=
GAMES_RELEASES_GATEWAY=
GAMES_RELEASES_DIR=
OPENAI_API_KEY=
PINECONE_API_KEY=
ONESIGNAL_SUFFIX=
RTFKT_RAFFLE_TOKEN=
# Minting signer private keys; never commit or prefix NEXT_PUBLIC_.
FACTORY_MANAGER_PRIVATE_KEY=
POLYGON_MANAGER_PRIVATE_KEY=
ANON_EDIT_SECRET=

# Social service (friends, parties, presence). Server-only.
SOCIAL_SERVICE_URL=
SOCIAL_SERVICE_SECRET=
# Firestore collection name prefix for social data (default "social").
SOCIAL_COLLECTION_PREFIX=

# Signs lobby identities (voice, chat, parties). At least 32 characters; set
# the same value on the lobby server.
LOBBY_IDENTITY_SECRET=

# Lobby roles: comma-separated wallet addresses or account IDs.
LOBBY_OWNERS=
LOBBY_ADMINS=
# Wallets that skip balance checks on preview deployments.
QA_WALLETS=
# Optional lobby pilot endpoint allowed by /dev/lobby-network in development.
NEXT_PUBLIC_LOBBY_PILOT_URL=

# Server-only list of wallets that may use the studio AI assistant, comma or
# space separated. Blank allows nobody.
AI_WHITELIST=

# World scripts: AI-written mini games on top of a space (docs/world-scripts.md).
# Off unless NEXT_PUBLIC_WORLD_SCRIPTS=1. The rest are server-only. The AI
# is in early access: the OpenRouter key pays for every request, so only
# site admins, the people they add (`pnpm world script access add <who>`)
# and accounts on the allowlist here (account ids or wallets, comma
# separated; * allows every editor) see the AI button and may ask, up to
# the daily limit each (default 40).
NEXT_PUBLIC_WORLD_SCRIPTS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
WORLD_SCRIPTS_AI_ALLOWLIST=
WORLD_SCRIPTS_AI_DAILY_LIMIT=

# Server-only key that signs the proof a visitor gets after entering a world's
# password; the multiplayer server must use the same value. Blank derives it
# from SECRET_JWT_KEY (the multiplayer server does the same).
WORLD_ACCESS_SECRET=

# Games kill switch (docs/games/field-health.md). Server-only list of game ids
# or game@release ids that must not load, comma or space separated, for
# example "ace, garden@27010df3470c88a0". Blank pauses nothing.
GAMES_DISABLED=
# Native worlds in a frame (docs/plans/framed-worlds.md): the origin of a
# second host of this app that serves worlds, framed by the site. Blank:
# worlds run in the page, as before. It must be another host, not a path or
# a port. Locally the dev server answers on both of these, so:
#   NEXT_PUBLIC_WORLD_ORIGIN=http://127.0.0.1:13000   (site: localhost:13000)
# A Vercel preview of the games-dev branch sets this by itself, to the
# deployment's own address (utils/siteOrigin.js), and turns world scripts on.
NEXT_PUBLIC_WORLD_ORIGIN=

# Say each load stage in the browser console as it happens ("[load] ..."),
# to see where a slow load spends its time. On by itself on Vercel previews.
NEXT_PUBLIC_LOAD_STAGES=

# Publishing a game from outside the repository (docs/games/publishing.md).
# Server-only. Blank is off (the development server treats blank as open);
# "open" lets any signed-in account publish; or a comma list of account ids.
# Published games are served only where game pages are (GAMES_PREVIEW=1 or
# the development server). Uploads go to the local releases folder
# (GAMES_RELEASES_DIR above; on by default on the development server).
GAMES_PUBLISHING=
# Where there is no releases folder (a serverless host), uploads go to a
# private Firebase Storage bucket instead: the creator's command sends each
# file through a short-lived signed address, and the site reads the release
# from the bucket to serve it. Blank uses the bucket when there is no
# releases folder; "on" uses it even when there is one (to try it on a
# development server, with `pnpm dev:local`); "off" never uses it. Needs
# FIREBASE_ADMIN_* above; setup steps are in docs/games/publishing.md.
GAMES_PUBLISHING_STORAGE=
# The bucket's name, if games get one of their own. Blank uses
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET.
GAMES_STORAGE_BUCKET=
# Not verified against the storage service; leave blank. "car" lets a server
# with no releases folder hand out upload addresses from its Pinata account
# (PINATA_JWT_KEY and GAMES_RELEASES_GATEWAY above).
GAMES_PUBLISHING_PINATA=
# Optional, development only: lets /dev/games show field health from real
# visits. A personal, read-only PostHog key and the project's numeric id.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Isolated guest player for legacy awe.box links. Set only after the separate
# player deployment can serve /play/:id?embed=oncyber. Use a bare HTTPS origin.
# NEXT_PUBLIC_AWE_PLAYER_ORIGIN=

# Optional. The domain search engines should credit (canonical links and
# the sitemap use it). Unset, the production site credits https://oncyber.io
# and every other deployment credits itself. Set it to
# https://www.oncyber.com when search results should move there.
# NEXT_PUBLIC_SEARCH_ORIGIN=
