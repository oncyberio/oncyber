# Copy to frontend/.env.local only if that file does not already exist.
# This is a core-settings template, not an isolated/offline configuration.
# Firebase settings are required: production builds fail without them.

# Next.js application origin, including its /api routes (not the Express API).
NEXT_PUBLIC_API=http://localhost:13000

# Optional local protocol-v1 crowd lobby.
# Start separately: npm --prefix multiplayer run lobby:dev
NEXT_PUBLIC_LOBBY_REGIONS='[{"id":"local","httpUrl":"http://127.0.0.1:2568","wsUrl":"ws://127.0.0.1:2568","protocol":1}]'
NEXT_PUBLIC_LOBBY_REGION=local

# Firebase browser configuration from your own development project.
# NEXT_PUBLIC_* values are visible to browser users.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional Cloud Functions base URL (emulator or another region).
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=

# Server-only Firebase Admin settings used by account/database API routes.
# Supply your development service-account values; never prefix these NEXT_PUBLIC_.
# Some local rendering fixtures can run without them; database routes cannot.
FIREBASE_ADMIN_TYPE=service_account
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_PRIVATE_KEY_ID=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_CLIENT_ID=
FIREBASE_ADMIN_AUTH_URI=
FIREBASE_ADMIN_TOKEN_URI=
FIREBASE_ADMIN_AUTH_PROVIDER_x509_CERT_URL=
FIREBASE_ADMIN_CLIENT_x509_CERT_URL=
# Optional Realtime Database URL override. Blank uses <project>-default-rtdb.
FIREBASE_ADMIN_DATABASE_URL=

# Server-side token operations; generate your own local secret before using them.
SECRET_JWT_KEY=

# Third-party API keys. Leave blank to disable the features that need them.
# NEXT_PUBLIC_* values are visible to browser users; restrict them by domain.
NEXT_PUBLIC_ETH_MAINNET_RPC=
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_BASE_RPC=
# Solana RPC with the Metaplex DAS API, for Solana NFT listings.
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_RESERVOIR_API_KEY=
NEXT_PUBLIC_NIFTYGATEWAY_CLIENT_ID=
NEXT_PUBLIC_SOUNDXYZ_API_KEY=
NEXT_PUBLIC_BICONOMY_API_KEY=
# Server-only.
OPENSEA_X_API_KEY=
NFTPORT_API_KEY=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT_KEY=
OPENAI_API_KEY=
PINECONE_API_KEY=
ONESIGNAL_SUFFIX=
RTFKT_RAFFLE_TOKEN=
# Minting signer private keys; never commit or prefix NEXT_PUBLIC_.
FACTORY_MANAGER_PRIVATE_KEY=
POLYGON_MANAGER_PRIVATE_KEY=
ANON_EDIT_SECRET=

# Social service (friends, parties, presence). Server-only.
SOCIAL_SERVICE_URL=
SOCIAL_SERVICE_SECRET=
# Firestore collection name prefix for social data (default "social").
SOCIAL_COLLECTION_PREFIX=

# Signs lobby identities (voice, chat, parties). At least 32 characters; set
# the same value on the lobby server.
LOBBY_IDENTITY_SECRET=

# Lobby roles: comma-separated wallet addresses or account IDs.
LOBBY_OWNERS=
LOBBY_ADMINS=
# Wallets that skip balance checks on preview deployments.
QA_WALLETS=
# Optional lobby pilot endpoint allowed by /dev/lobby-network in development.
NEXT_PUBLIC_LOBBY_PILOT_URL=

# Server-only list of wallets that may use the studio AI assistant, comma or
# space separated. Blank allows nobody.
AI_WHITELIST=

# Server-only key that signs the proof a visitor gets after entering a world's
# password; the multiplayer server must use the same value. Blank derives it
# from SECRET_JWT_KEY (the multiplayer server does the same).
WORLD_ACCESS_SECRET=
