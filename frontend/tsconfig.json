            "@3editgui/*": ["components/_3DExhibit-v2/three/gui/*"],
            "@3xtend": ["components/_3DExhibit-v2/three/threextend/index.js"],
            "@3globals/*": ["components/_3DExhibit-v2/three/globals/*"],
            "@3textures": ["components/_3DExhibit-v2/three/textures.js"],
