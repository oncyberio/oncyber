            "@3gltf": ["components/_3DExhibit-v2/three/gltf.js"],
            "@3whitelist": ["utils/whitelist.json"],
            "@features": ["features/*"],
            "env": ["env"]
        },
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ]
    },
    "include": [
        "next-env.d.ts",
        "**/*.js",
        "**/*.ts",
        "**/*.tsx",
        "specs/mint.test.js",
