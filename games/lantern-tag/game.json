{
    "name": "Lantern Tag",
    "avatar": "vrm",
    "listing": {
        "tagline": "catch the lanterns before they fade",
        "description": "Lanterns light up around a night-time courtyard. Walk to one to catch it before it fades. A round lasts 90 seconds; play alone against the night or with your party.",
        "players": {
            "min": 1,
            "max": 8
        },
        "tags": ["party", "arcade", "tag", "night"]
    },
    "page": {
        "socialRoom": "oncyber-lantern-tag-social-v1",
        "crowdLabel": "in the courtyard"
    },
    "network": ["cyber.mypinata.cloud"],
    "format": "match",
    "devices": ["desktop", "phone", "gamepad"],
    "avatars": {
        "others": "avatar",
        "arrival": "pose",
        "change": true
    },
    "arrival": {
        "walkable": true
    },
    "locomotion": "lobby",
    "departure": "matched",
    "party": {
        "sizes": [1, 8],
        "formats": [
            {
                "id": "duel",
                "label": "Head to head",
                "sizes": [2]
            },
            {
                "id": "round",
                "label": "Everyone plays",
                "sizes": [3, 4, 5, 6, 7, 8]
            },
            {
                "id": "solo",
                "label": "Solo round",
                "sizes": [1, 2, 3, 4, 5, 6, 7, 8]
            }
        ],
        "solo": "solo",
        "play": "duel",
        "late": "A member who arrives while the party's round is on can join it in progress, starting from zero, or play a solo round.",
        "dropped": "The round goes on without them and their score stays on the board, marked as left. If they were running the round, another member takes it over.",
        "extra": "A round seats the whole party, up to eight, so nobody sits out. A member who would rather not join can play solo or walk the courtyard."
    },
    "keysCheck": {
        "start": ["KeyE"],
        "ready": {
            "screen": "arrival"
        },
        "move": "KeyW"
    },
    "results": {
        "match": "autoplay&round=20",
        "timeoutSeconds": 240
    },
    "runtime": {
        "profile": "portable-v1",
        "version": "1",
        "platforms": ["web"],
        "entries": {
            "web": "index.html",
            "game": "src/game.js",
            "scenario": "scenario.json"
        },
        "capabilities": ["audio", "avatar", "results", "travel"],
        "assets": [],
        "input": {
            "up": {
                "keyboard": ["KeyW", "ArrowUp"],
                "touch": "stick-up",
                "gamepad": ["left-stick-up", "dpad-up"]
            },
            "down": {
                "keyboard": ["KeyS", "ArrowDown"],
                "touch": "stick-down",
                "gamepad": ["left-stick-down", "dpad-down"]
            },
            "left": {
                "keyboard": ["KeyA", "ArrowLeft"],
                "touch": "stick-left",
                "gamepad": ["left-stick-left", "dpad-left"]
            },
            "right": {
                "keyboard": ["KeyD", "ArrowRight"],
                "touch": "stick-right",
                "gamepad": ["left-stick-right", "dpad-right"]
            },
            "interact": {
                "keyboard": ["KeyE", "KeyJ"],
                "touch": "button:Go",
                "gamepad": "button-x"
            },
            "jump": {
                "keyboard": ["Space"],
                "touch": "button:Jump",
                "gamepad": "button-a"
            },
            "run": {
                "keyboard": ["ShiftLeft", "ShiftRight"],
                "touch": "button:Run",
                "gamepad": ["right-trigger", "left-stick-press"]
            },
            "back": {
                "keyboard": ["Backspace"],
                "gamepad": "button-b"
            },
            "lookX": {
                "touch": "drag",
                "gamepad": "right-stick-x"
            },
            "lookY": {
                "touch": "drag",
                "gamepad": "right-stick-y"
            }
        }
    },
    "credits": [
        {
            "title": "three.js",
            "kind": "library",
            "package": "three",
            "author": "three.js authors",
            "source": "https://github.com/mrdoob/three.js",
            "license": "MIT",
            "licenseFile": "licenses/three-MIT.txt"
        },
        {
            "title": "three-vrm",
            "kind": "library",
            "package": "@pixiv/three-vrm",
            "author": "pixiv Inc.",
            "source": "https://github.com/pixiv/three-vrm",
            "license": "MIT",
            "licenseFile": "licenses/three-vrm-MIT.txt"
        },
        {
            "title": "Basis Universal transcoder",
            "kind": "library",
            "files": [
                "assets/basis_transcoder-*.js",
                "assets/basis_transcoder-*.wasm"
            ],
            "author": "Binomial LLC",
            "source": "https://github.com/BinomialLLC/basis_universal",
            "license": "Apache-2.0",
            "licenseFile": "licenses/basis-universal-Apache-2.0.txt",
            "note": "Shipped inside the three.js package; decodes compressed avatar textures."
        },
        {
            "title": "Space Grotesk",
            "kind": "font",
            "files": ["assets/SpaceGrotesk-*.woff2"],
            "author": "The Space Grotesk Project Authors",
            "source": "https://github.com/floriankarsten/space-grotesk",
            "license": "OFL-1.1",
            "licenseFile": "licenses/SpaceGrotesk-OFL-1.1.txt",
            "note": "Regular and Medium, bundled from Oncyber's UI kit (games/kits/ui/fonts)."
        },
        {
            "title": "Space Mono",
            "kind": "font",
            "files": ["assets/SpaceMono-*.woff2"],
            "author": "The Space Mono Project Authors",
            "source": "https://github.com/googlefonts/spacemono",
            "license": "OFL-1.1",
            "licenseFile": "licenses/SpaceMono-OFL-1.1.txt",
            "note": "Regular, bundled from Oncyber's UI kit (games/kits/ui/fonts)."
        }
    ]
}
