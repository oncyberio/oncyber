{
  "name": "Glasshouse · Padel",
  "avatar": "vrm",
  "listing": {
    "tagline": "doubles padel with NPC partners",
    "description": "Walk the club as your avatar, then play doubles on a glass court with an NPC partner against two NPC opponents.",
    "players": {
      "min": 1,
      "max": 1
    },
    "tags": [
      "sports",
      "club"
    ]
  },
  "page": {
    "room": "oncyber-padel-club-v2",
    "crowdLabel": "at the club",
    "controls": {
      "top": 14
    }
  },
  "network": [
    "cyber.mypinata.cloud"
  ],
  "format": "match",
  "devices": [
    "desktop",
    "gamepad"
  ],
  "avatars": {
    "others": "avatar",
    "arrival": "pose"
  },
  "arrival": {
    "walkable": true
  },
  "locomotion": "lobby",
  "party": {
    "sizes": [
      1,
      8
    ],
    "formats": [
      {
        "id": "doubles",
        "label": "Doubles with NPCs",
        "sizes": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    ],
    "solo": "doubles",
    "shared": "Padel is one visitor with an NPC partner against two NPCs: there is no match between people yet. Party members share the club, see each other walk it, and each plays their own match.",
    "late": "Arrives in the club and starts their own match when they like.",
    "dropped": "Nothing changes for the others: every match is local to its player.",
    "extra": "No seats to run out of: each member plays their own match.",
    "note": "NPC doubles only. Playing doubles between party members is not built."
  },
  "runtime": {
    "profile": "portable-v1",
    "version": "1",
    "platforms": [
      "web"
    ],
    "entries": {
      "web": "index.html",
      "game": "src/game.js",
      "scenario": "scenario.json"
    },
    "capabilities": [
      "avatar",
      "results",
      "storage",
      "travel"
    ],
    "assets": [],
    "input": {
      "up": {
        "keyboard": [
          "KeyW"
        ],
        "touch": "stick-up",
        "gamepad": [
          "left-stick-up",
          "dpad-up"
        ]
      },
      "down": {
        "keyboard": [
          "KeyS"
        ],
        "touch": "stick-down",
        "gamepad": [
          "left-stick-down",
          "dpad-down"
        ]
      },
      "left": {
        "keyboard": [
          "KeyA"
        ],
        "touch": "stick-left",
        "gamepad": [
          "left-stick-left",
          "dpad-left"
        ]
      },
      "right": {
        "keyboard": [
          "KeyD"
        ],
        "touch": "stick-right",
        "gamepad": [
          "left-stick-right",
          "dpad-right"
        ]
      },
      "aimUp": {
        "keyboard": [
          "ArrowUp"
        ],
        "gamepad": "right-stick-up"
      },
      "aimDown": {
        "keyboard": [
          "ArrowDown"
        ],
        "gamepad": "right-stick-down"
      },
      "aimLeft": {
        "keyboard": [
          "ArrowLeft"
        ],
        "gamepad": "right-stick-left"
      },
      "aimRight": {
        "keyboard": [
          "ArrowRight"
        ],
        "gamepad": "right-stick-right"
      },
      "hit": {
        "keyboard": [
          "KeyJ",
          "Space"
        ],
        "touch": "button:Hit",
        "gamepad": "button-a"
      },
      "lob": {
        "keyboard": [
          "KeyK"
        ],
        "touch": "button:Lob",
        "gamepad": "button-y"
      },
      "power": {
        "keyboard": [
          "KeyF"
        ],
        "touch": "button:Power",
        "gamepad": [
          "button-x",
          "right-bumper"
        ]
      },
      "confirm": {
        "keyboard": [
          "KeyJ",
          "Space"
        ],
        "touch": "button:OK",
        "gamepad": "button-a"
      },
      "back": {
        "keyboard": [
          "Backspace"
        ],
        "gamepad": "button-b"
      },
      "pause": {
        "keyboard": [
          "KeyP"
        ],
        "touch": "button:Pause",
        "gamepad": "button-start"
      },
      "view": {
        "keyboard": [
          "KeyC"
        ],
        "gamepad": "button-select"
      },
      "run": {
        "keyboard": [
          "ShiftLeft",
          "ShiftRight"
        ],
        "touch": "button:Run",
        "gamepad": [
          "right-trigger",
          "left-stick-press"
        ]
      },
      "jump": {
        "keyboard": [
          "Space"
        ],
        "touch": "button:Jump",
        "gamepad": "button-x"
      },
      "lookX": {
        "touch": "drag"
      },
      "lookY": {
        "touch": "drag"
      },
      "wave": {
        "keyboard": [
          "KeyG"
        ]
      },
      "dance": {
        "keyboard": [
          "KeyB"
        ]
      },
      "sit": {
        "keyboard": [
          "KeyV"
        ]
      }
    }
  },
  "keysCheck": {
    "start": [],
    "ready": {
      "screen": "arrival"
    },
    "move": "KeyW"
  },
  "departure": "matched",
  "results": {
    "match": "autoplay&points=2",
    "timeoutSeconds": 300
  },
  "saved": {
    "settings": {
      "scope": "visitor",
      "stateVersion": 1,
      "maxBytes": 256,
      "sample": {
        "difficulty": "competitive",
        "graphics": "balanced",
        "camera": "courtside"
      }
    }
  },
