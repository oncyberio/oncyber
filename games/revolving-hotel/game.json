{
    "name": "The Revolving Hotel",
    "avatar": "vrm",
    "listing": {
        "tagline": "the floor is about to move",
        "description": "Cross a rotating hotel corridor as your Oncyber avatar. Fight two agents, leap between surfaces and reach the lift, or watch the choreographed sequence.",
        "thumbnail": "preview.jpg",
        "players": {
            "min": 1,
            "max": 1
        },
        "tags": [
            "action",
            "cinematic",
            "gravity"
        ]
    },
    "page": {
        "socialRoom": "revolving-hotel-social-v1",
        "crowdLabel": "in the hotel"
    },
    "network": [
        "cyber.mypinata.cloud"
    ],
    "format": "match",
    "devices": [
        "desktop",
        "phone",
        "gamepad"
    ],
    "avatars": {
        "others": "avatar",
        "arrival": "pose",
        "change": true
    },
    "arrival": {
        "walkable": true
    },
    "locomotion": "lobby",
    "departure": "matched",
    "party": {
        "sizes": [
            1,
            8
        ],
        "formats": [
            {
                "id": "solo",
                "label": "Corridor run",
                "sizes": [
                    1,
                    2,
                    3,
                    4,
                    5,
                    6,
                    7,
                    8
                ]
            }
        ],
        "solo": "solo",
        "play": "solo",
        "late": "A new arrival can explore the corridor or start their own run.",
        "dropped": "One visitor leaving does not interrupt anyone else\u2019s run.",
        "extra": "Every visitor has their own two agents and retains the shared social room."
    },
    "keysCheck": {
        "start": [],
        "ready": {
            "screen": "arrival"
        },
        "move": "KeyW"
    },
    "results": {
        "match": "autoplay&round=20",
        "timeoutSeconds": 240
    },
    "runtime": {
        "profile": "portable-v1",
        "version": "1",
        "platforms": [
            "web"
        ],
        "entries": {
            "web": "index.html",
            "game": "src/game.js",
            "scenario": "scenario.json"
        },
        "capabilities": [
            "audio",
            "avatar",
            "results",
            "travel"
        ],
        "assets": [],
        "input": {
            "up": {
                "keyboard": [
                    "KeyW",
                    "ArrowUp"
                ],
                "touch": "stick-up",
                "gamepad": [
                    "left-stick-up",
                    "dpad-up"
                ]
            },
            "down": {
                "keyboard": [
                    "KeyS",
                    "ArrowDown"
                ],
                "touch": "stick-down",
                "gamepad": [
                    "left-stick-down",
                    "dpad-down"
                ]
            },
            "left": {
                "keyboard": [
                    "KeyA",
                    "ArrowLeft"
                ],
                "touch": "stick-left",
                "gamepad": [
                    "left-stick-left",
                    "dpad-left"
                ]
            },
            "right": {
                "keyboard": [
                    "KeyD",
                    "ArrowRight"
                ],
                "touch": "stick-right",
                "gamepad": [
                    "left-stick-right",
                    "dpad-right"
                ]
            },
            "interact": {
                "keyboard": [
                    "KeyE"
                ],
                "touch": "button:Go",
                "gamepad": "button-x"
            },
            "jump": {
                "keyboard": [
                    "Space"
                ],
                "touch": "button:Jump",
                "gamepad": "button-a"
            },
            "run": {
                "keyboard": [
                    "ShiftLeft",
                    "ShiftRight"
                ],
                "touch": "button:Run",
                "gamepad": [
                    "right-trigger",
                    "left-stick-press"
                ]
            },
            "back": {
                "keyboard": [
                    "Backspace"
                ],
                "gamepad": "button-b"
            },
            "lookX": {
                "touch": "drag",
                "gamepad": "right-stick-x"
            },
            "lookY": {
                "touch": "drag",
                "gamepad": "right-stick-y"
            },
            "strike": {
                "keyboard": [
                    "KeyJ"
                ],
                "touch": "button:Strike",
                "gamepad": "right-bumper"
            },
            "watch": {
                "keyboard": [
                    "KeyC"
                ],
                "touch": "button:Watch",
                "gamepad": "button-y"
            }
        }
    },
