    "./partyLink": "./src/partyLink.ts",
    "./results": "./src/results.ts",
    "./devices": "./src/devices.ts",
    "./device-controls": "./src/deviceControls.ts",
    "./device-check": "./src/deviceCheck.ts",
    "./loading": "./src/loading.ts",
    "./pausing": "./src/pausing.ts",
