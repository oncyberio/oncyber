{
  "name": "Bloom Garden",
  "avatar": "vrm",
  "listing": {
    "tagline": "raise bloomlings with other players",
    "description": "Hatch a bloomling, feed it, pet it and watch it grow up. Race and bump with other players' bloomlings.",
    "thumbnail": "preview.jpg",
    "players": {
      "min": 1,
      "max": 32
    },
    "tags": [
      "pets",
      "social",
      "cozy"
    ]
  },
  "page": {
    "room": "oncyber-bloom-garden-v1",
    "relay": true,
    "crowdLabel": "in the garden",
    "controls": {
      "top": 14,
      "left": "auto",
      "right": 16
    }
  },
  "format": "world",
  "avatars": {
    "others": "avatar",
    "arrival": "none",
    "arrivalWhy": "The garden matches the lobby's camera, crouch and empty hands itself (the process stage checks the handoff); it does not use the avatar kit's arrival pose yet."
  },
  "arrival": {
    "walkable": true
  },
  "party": {
    "sizes": [
      1,
      8
    ],
    "formats": [
      {
        "id": "garden",
        "label": "Share the garden",
        "sizes": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    ],
    "solo": "garden",
    "shared": "Everyone on the island plays the same garden whatever the party's size; a party gets an island of its own.",
    "late": "Arrives on the island as it is. Can join a mini game while its gate is open, or watch one under way.",
    "dropped": "Their avatar and bloomlings leave the island; their save is kept by the page and returns with them. A mini game they were hosting is not handed to another member yet.",
    "extra": "Mini games seat four racers or two fighters; everyone else watches and cheers. Empty spots get CPU rivals, so one member can always play."
  },
  "devices": [
    "desktop",
    "gamepad"
  ],
  "runtime": {
    "profile": "portable-v1",
    "version": "1",
    "platforms": [
      "web",
      "ios",
      "android"
    ],
    "entries": {
      "web": "index.html",
      "game": "src/game/game.js",
      "ui": "ui.html",
      "scenario": "scenario.json"
