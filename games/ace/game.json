{
  "name": "ACE! Tennis",
  "avatar": "vrm",
  "devices": [
    "desktop",
    "phone",
    "gamepad"
  ],
  "avatars": {
    "others": "avatar",
    "arrival": "pose"
  },
  "arrival": {
    "walkable": true
  },
  "locomotion": "lobby",
  "party": {
    "sizes": [
      1,
      8
    ],
    "formats": [
      {
        "id": "singles",
        "label": "1 v 1",
        "sizes": [
          2
        ]
      },
      {
        "id": "doubles",
        "label": "2 v 2",
        "sizes": [
          4
        ]
      },
      {
        "id": "tournament",
        "label": "Tournament",
        "sizes": [
          3,
          4,
          5,
          6,
          7,
          8
        ]
      },
      {
        "id": "solo",
        "label": "Solo vs CPU",
        "sizes": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      }
    ],
    "solo": "solo",
    "play": "singles",
    "late": "A member who arrives while two others are mid-match is offered Watch (a courtside view of the live match) and Solo vs CPU. The party menu redraws its formats for the new count.",
    "dropped": "The CPU takes a dropped player's side and the match goes on with the score kept. If the dropped player was running the match, the other takes it over and the point is replayed from the serve. Coming back while the match lasts (a reconnect, or Rejoin your match after a reload) returns their side to them.",
    "extra": "A match seats two. Anyone else in the room can watch the live match or play solo against the CPU.",
    "note": "1 v 1 is played between the two members. Doubles and tournaments show the seeded draw; playing them through is not built yet."
  },
  "runtime": {
    "profile": "portable-v1",
    "version": "1",
    "platforms": [
      "web"
    ],
    "entries": {
      "web": "index.html",
      "game": "src/game.js",
      "scenario": "scenario.json"
    },
    "capabilities": [
      "avatar",
      "results",
      "storage",
      "travel"
    ],
    "assets": [],
    "input": {
      "up": {
        "keyboard": [
          "KeyW",
          "ArrowUp"
        ],
        "touch": "stick-up",
        "gamepad": [
          "left-stick-up",
          "dpad-up"
        ]
      },
      "down": {
        "keyboard": [
          "KeyS",
          "ArrowDown"
        ],
        "touch": "stick-down",
        "gamepad": [
          "left-stick-down",
          "dpad-down"
        ]
      },
      "left": {
        "keyboard": [
          "KeyA",
          "ArrowLeft"
        ],
        "touch": "stick-left",
        "gamepad": [
          "left-stick-left",
          "dpad-left"
        ]
      },
      "right": {
        "keyboard": [
          "KeyD",
          "ArrowRight"
        ],
        "touch": "stick-right",
        "gamepad": [
          "left-stick-right",
          "dpad-right"
        ]
      },
      "flat": {
        "keyboard": [
          "KeyJ",
          "Space"
        ],
        "touch": "button:Hit",
        "gamepad": "button-a"
      },
      "topspin": {
        "keyboard": [
          "KeyK"
        ],
        "touch": "button:Top",
        "gamepad": "button-x"
      },
      "slice": {
        "keyboard": [
          "KeyH"
        ],
        "touch": "button:Cut",
        "gamepad": "button-b"
      },
      "lob": {
        "keyboard": [
          "KeyU"
        ],
        "touch": "button:Lob",
        "gamepad": "button-y"
      },
      "drop": {
        "touch": "button:Drop",
        "gamepad": [
          "left-bumper",
          "right-bumper"
        ]
      },
      "confirm": {
        "keyboard": [
          "Space",
          "KeyJ"
        ],
        "touch": "button:OK",
        "gamepad": "button-a"
      },
      "back": {
        "keyboard": [
          "Backspace",
          "KeyK"
        ],
        "gamepad": "button-b"
      },
      "pause": {
        "keyboard": [
          "KeyP"
        ],
        "touch": "button:Pause",
        "gamepad": "button-start"
      },
      "run": {
        "keyboard": [
          "ShiftLeft",
          "ShiftRight"
        ],
        "touch": "button:Run",
        "gamepad": [
          "right-trigger",
          "left-stick-press"
        ]
      },
      "jump": {
        "keyboard": [
          "Space"
        ],
        "touch": "button:Jump",
        "gamepad": "button-x"
      },
      "lookX": {
        "touch": "drag"
      },
      "lookY": {
        "touch": "drag"
      },
      "wave": {
        "keyboard": [
          "KeyG"
        ]
      },
      "dance": {
        "keyboard": [
          "KeyB"
        ]
      },
      "sit": {
        "keyboard": [
          "KeyV"
        ]
      }
    }
  },
  "keysCheck": {
    "start": [
      "Space",
      "Space"
    ],
    "ready": {
      "screen": "playing"
    },
    "move": "KeyD"
  },
  "departure": "matched",
  "results": {
    "match": "autoplay&games=1&difficulty=rookie&slow=3",
    "timeoutSeconds": 240
  },
  "saved": {
    "settings": {
      "scope": "visitor",
      "stateVersion": 1,
      "maxBytes": 256,
      "sample": {
        "difficulty": "rookie",
        "games": 3
      },
      "old": [
        {
          "stateVersion": 0,
          "value": "{\"difficulty\":\"ace\",\"games\":1}",
          "expect": "migrated"
        }
      ]
    },
    "format": {
      "scope": "party",
      "stateVersion": 1,
      "maxBytes": 128,
      "sample": {
        "format": "singles"
      }
    },
    "tally": {
      "scope": "game",
      "stateVersion": 1,
      "maxBytes": 64,
      "sample": {
        "matches": 1
      }
    }
  }
}
