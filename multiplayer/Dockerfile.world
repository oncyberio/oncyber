# Dedicated shared-world service. Keep the existing gallery multiplayer image separate.
FROM node:22.23.4-trixie-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
COPY protocol ./protocol
RUN npm run build

FROM node:22.23.4-trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates gosu && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
# Catch Linux native ABI mismatches during the image build, not after deploy.
RUN node -e "import('@fails-components/webtransport-transport-http3-quiche').then(() => console.log('Native QUIC loaded')).catch(e => { console.error(e); process.exit(1) })"
COPY --from=build /app/build ./build
COPY protocol ./protocol
COPY scripts/lobby-cert.cjs ./scripts/lobby-cert.cjs
COPY scripts/lobby-world-entrypoint.sh ./scripts/lobby-world-entrypoint.sh
# Configure an ingress and mount a trusted TLS certificate for public deployment.
# These declarations do not publish ports or change the default loopback bind.
EXPOSE 2575/tcp 2576-2583/tcp 2590/udp
CMD ["sh", "scripts/lobby-world-entrypoint.sh"]
