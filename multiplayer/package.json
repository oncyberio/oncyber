{
    "private": true,
    "name": "my-app",
    "version": "1.0.0",
    "description": "npm init template for bootstrapping an empty Colyseus project",
    "main": "build/index.js",
    "scripts": {
        "start": "ts-node-dev --respawn --transpile-only src/index.ts",
        "loadtest": "colyseus-loadtest loadtest/example.ts --room cyber --numClients 200 --endpoint ws://localhost:2567",
        "build": "npm run clean && node node_modules/typescript/lib/tsc.js",
        "clean": "node node_modules/rimraf/bin build",
        "test": "TS_NODE_FILES=true node node_modules/mocha/bin/mocha --require ts-node/register test/**_test.ts --exit --timeout 20000",
        "serve": "NODE_ENV=production node build/index.js",
        "debug": "DEBUG=colyseus:matchmaking npm start",
        "lobby:dev": "node node_modules/ts-node/dist/bin.js --transpile-only src/lobby-dev.ts",
        "lobby:load": "node loadtest/crowd.cjs",
        "test:lobby": "TS_NODE_FILES=true node node_modules/mocha/bin/mocha --require ts-node/register test/Crowd*_test.ts --exit --timeout 20000",
        "lobby:serve": "node build/lobby-server.js",
        "lobby:world": "node node_modules/ts-node/dist/bin.js --transpile-only src/lobby-world.ts",
        "lobby:world:serve": "node build/lobby-world.js",
        "lobby:world:load": "node loadtest/world.cjs",
        "test:lobby-world": "TS_NODE_FILES=true node node_modules/mocha/bin/mocha --require ts-node/register test/World*_test.ts test/WebTransport_test.ts test/QuicImpairment_test.ts --exit --timeout 20000",
        "test:lobby-wire": "node --test test/LobbyWire_test.cjs",
        "test:lobby-quic": "node scripts/lobby-wt-smoke.cjs",
        "test:lobby-quic-loss": "node scripts/lobby-wt-impaired.cjs",
        "lobby:world:load-quic": "node loadtest/world-quic.cjs",
        "test:lobby-fly": "node scripts/lobby-fly-smoke.cjs",
        "test:lobby-regression": "npm run build && npm run test:lobby-wire && npm run test:lobby-world && npm run test:lobby-quic && npm run test:lobby-quic-loss && node --test test/FlyProbeLogs_test.cjs",
        "lab:lobby": "npm run build && node scripts/lobby-lab.cjs",
        "test:lobby-feel": "node scripts/lobby-feel.cjs",
        "test:lobby-crowd-feel": "node scripts/lobby-crowd-audit.cjs",
        "test:lobby-regional": "node scripts/lobby-regional.cjs"
    },
    "author": "",
    "license": "UNLICENSED",
    "bugs": {
        "url": "https://github.com/colyseus/create-colyseus/issues"
    },
    "homepage": "https://github.com/colyseus/create-colyseus#readme",
    "devDependencies": {
        "@colyseus/loadtest": "^0.14.4",
        "@colyseus/testing": "^0.14.21",
        "@flydotio/dockerfile": "^0.7.4",
        "@types/cors": "^2.8.6",
        "@types/express": "^4.17.1",
        "@types/lodash": "^4.14.194",
        "@types/mocha": "^8.2.3",
        "@types/node-fetch": "^2.6.1",
        "@types/three": "^0.149.0",
        "copyfiles": "^2.4.1",
        "mocha": "^9.0.2",
        "rimraf": "^2.7.1",
        "ts-node": "^8.1.0",
        "ts-node-dev": "^1.0.0-pre.63",
        "typescript": "^5.0.4"
    },
    "dependencies": {
        "@colyseus/arena": "^0.14.22",
        "@colyseus/monitor": "^0.14.20",
        "@fails-components/webtransport": "1.6.8",
        "@fails-components/webtransport-transport-http3-quiche": "1.6.8",
        "acme-client": "5.4.0",
        "async-mutex": "^0.4.0",
        "colors": "^1.4.0",
        "colyseus": "^0.14.23",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.16.4",
        "express-basic-auth": "^1.2.1",
        "express-rate-limit": "^6.7.0",
        "firebase-admin": "^13.0.2",
        "lodash": "^4.17.21",
        "node-fetch": "^2.6.7",
        "shortid": "^2.2.16",
        "three": "^0.150.1"
    },
    "overrides": {
        "mongoose": "^6.13.12"
    }
}
