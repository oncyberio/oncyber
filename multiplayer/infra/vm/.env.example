# Copy to ./env (gitignored) and fill in. Loaded by docker compose.

# --- Colyseus ---
MAX_PLAYERS=200
COLYSEUS_SEAT_RESERVATION_TIME=30
DEBUG=colyseus:errors
# express-basic-auth password for the /cyber-h monitor (was a fly secret)
MONITOR_PASSWORD=replace-with-a-strong-value

# --- prebuilt image (Artifact Registry) ---
COLYSEUS_IMAGE=us-central1-docker.pkg.dev/REPLACE_PROJECT/mmo/colyseus:latest

# --- TURN (coturn) ---
# openssl rand -hex 32
TURN_SECRET=replace-with-32-byte-hex
# the public hostname clients dial for TURN (can be the same VM domain or its IP)
TURN_HOST=arena.oncyber.io
# coturn external-ip mapping, MANDATORY on GCP (1:1 NAT): PUBLIC/PRIVATE
TURN_EXTERNAL_IP=REPLACE_PUBLIC_IP/REPLACE_PRIVATE_IP
# optional, server caps to 3600
TURN_TTL=3600

# --- mod check (server-side isMod against the web API) ---
# optional; defaults to https://oncyber.io/api
#ONCYBER_API_URL=https://oncyber.io/api
# RECOMMENDED: Vercel "Protection Bypass for Automation" secret (Vercel project
# -> Settings -> Security). Without it, bot protection can challenge the VM's
# server-side mod checks and every room silently loses its mods.
#VERCEL_PROTECTION_BYPASS=replace-with-vercel-bypass-secret

# Same value as the frontend: verifies Oncyber session tokens on join/login.
SECRET_JWT_KEY=

# Same value as the frontend: verifies the signed proof a visitor gets after
# entering a world's password. Without it a key is derived from SECRET_JWT_KEY
# (the frontend does the same); with neither, password-gated rooms refuse
# every join.
#WORLD_ACCESS_SECRET=
