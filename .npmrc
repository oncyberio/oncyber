# npm-style flat node_modules: the legacy dependency tree (and parts of the
# Next.js build) rely on hoisted "phantom" dependencies that pnpm's default
# strict layout would break.
node-linker=hoisted

# Equivalent of npm's legacy-peer-deps, which this repo always needed:
# don't fail on peer conflicts and don't auto-add peers npm never installed.
strict-peer-dependencies=false
auto-install-peers=false
